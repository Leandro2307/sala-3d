{
  "manifest_version": 3,
  "name": "Sala 3D — controle das abas",
  "version": "1.15.0",
  "description": "Mostra abas na Sala 3D sem a faixa do Chrome (Alt+Shift+S; de novo, tira), deixa os amigos clicarem e digitarem nas abas, janelas e telas que você compartilha (só nas que você liberar) e abre qualquer site no navegador das telas da sala.",
  "key": "",
  "permissions": [
    "debugger",
    "tabCapture",
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "nativeMessaging",
    "declarativeNetRequest",
    "webNavigation",
    "webRequest",
    "cookies",
    "contentSettings"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "fundo.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "conteudo.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "commands": {
    "compartilhar-aba": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Mostrar esta aba na Sala 3D sem a faixa do Chrome (ou tirar, se ela já está lá)"
    }
  },
  "action": {
    "default_title": "Sala 3D — controle das abas",
    "default_popup": "popup.html"
  }
}
