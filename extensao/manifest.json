{
  "manifest_version": 3,
  "name": "Sala 3D — controle das abas",
  "version": "1.2.0",
  "description": "Deixa os amigos da Sala 3D clicarem e digitarem nas abas, janelas e telas que você compartilha (só nas que você liberar).",
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "fundo.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "conteudo.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Sala 3D — controle das abas",
    "default_popup": "popup.html"
  }
}
