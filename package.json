{
  "name": "sala-3d",
  "version": "1.0.0",
  "private": true,
  "description": "Sala 3D para compartilhar tela, voz e YouTube com amigos — com parkour.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"testes/*.test.mjs\" && node scripts/testar-poker.js",
    "dev": "node --watch server.js",
    "https": "node server.js --https",
    "gerar-vozes-cartas": "node scripts/gerar-vozes-cartas.js",
    "tunnel": "cloudflared.exe tunnel --url http://localhost:3000 --no-autoupdate",
    "publico": "node scripts/publico.js",
    "navegador": "node scripts/navegador.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "compression": "^1.8.2",
    "dashjs": "^5.2.1",
    "express": "^5.2.1",
    "hls.js": "^1.7.3",
    "mysql2": "^3.24.5",
    "selfsigned": "^5.5.0",
    "socket.io": "^4.8.4",
    "three": "^0.186.1"
  }
}
